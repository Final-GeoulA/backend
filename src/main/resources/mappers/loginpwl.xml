<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
 <mapper namespace="kr.co.ictedu.geoulA.passwordless.LoginPwlDao">
 	<!-- 유효성 검사 -->
 	<select id="checkValidation" parameterType="uvo" resultType="uvo">
 		SELECT email, password FROM USERS WHERE email = #{email} AND password = #{password}
 	</select>
 	
 	<!-- 유저 정보 검색 -->
 	<select id="getUserInfo" parameterType="uvo" resultType="uvo">
 		SELECT email, password FROM USERS WHERE email = #{email}
 	</select>
 	
 	<!-- 비밀번호 변경 -->
 	<update id="updatePassword">
 		UPDATE USERS SET password = #{password} WHERE email = #{email}
 	</update>
 	
 	<!-- 유저 삭제 -->
 	<delete id="withdrawUserInfo">
 		DELETE FROM USERS WHERE email = #{email}
 	</delete>
 	
 </mapper>