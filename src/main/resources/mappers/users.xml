<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
 <mapper namespace="kr.co.ictedu.geoulA.users.UsersDao">
 <insert id="insertUser" parameterType="uvo">
 insert into users(user_id,email,password,nickname,age,skin_type,gender) values(seq_users.nextval,#{email},#{password},#{nickname},#{age},#{skin_type},#{gender})
 </insert>
 <select id="countByEmail" parameterType="string" resultType="int">
select count(*) cnt from users where email = #{email}
</select>
<select id="useCheckEmail" parameterType="string" resultType="string">
select email from users where email = #{email}
</select>
 <update id="changePassword" parameterType="uvo">
	  update users set password=#{password} where email=#{email}
 </update>
 </mapper>